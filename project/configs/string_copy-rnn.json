{
    "logging_config": {
        "save_path": "./logs",
        "experiment_name": "string_copy-rnn",
        "log_interval": 1,
        "checkpoint_interval": 10,
        "validation_interval": 1
    },
    "model_config": {
        "architecture": "DecoderGRU",
        "kwargs": {
            "hidden_size": 64,
            "num_gru_layers": 2
        }
    },
    "optimizer_config": {
        "optimizer": "Adam",
        "kwargs": {
            "lr": 3e-4
        }
    },
    "dataset_config": {
        "train": {
            "dataset_name": "CopyDataset",
            "kwargs": {
                "max_question_len": 10,
                "split": "train",
                "train_val_ratio": 0.8
            },
            "num_workers": 1,
            "batch_size": 32
        },
        "validation": [
            {
                "name": "heldout",
                "dataset_name": "CopyDataset",
                "kwargs": {
                    "max_question_len": 10,
                    "split": "val",
                    "train_val_ratio": 0.8
                },
                "num_workers": 1,
                "batch_size": 32
            }
        ]
    },
    "learner": "NextTokenLearner",
    "train_loss_config": {},
    "num_epochs": 1000,
    "seed": 0
}