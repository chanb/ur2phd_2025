{
    "logging_config": {
        "save_path": "./logs",
        "experiment_name": "multiplication_debug",
        "log_interval": 10,
        "checkpoint_interval": 100,
        "validation_interval": 10
    },
    "model_config": {
        "architecture": "DecoderGRU",
        "kwargs": {
            "hidden_size": 64,
            "num_gru_layers": 2
        }
    },
    "optimizer_config": {
        "optimizer": "Adam",
        "kwargs": {
            "lr": 3e-4
        }
    },
    "dataset_config": {
        "train": {
            "dataset_name": "MultiplicationDataset",
            "kwargs": {
                "train_max_digits": 3,
                "test_max_digits": 6,
                "split": "train",
                "num_samples": 50000
            },
            "num_workers": 1,
            "batch_size": 32
        }
    },
    "learner": "NextTokenLearner",
    "train_loss_config": {},
    "num_epochs": 1000,
    "seed": 0
}